+        textureImageCommandCount++;
+        if (width > maxTextureWidth) {
+            maxTextureWidth = width;
+        }
+    }
+
+    void DKRDisplayListDiagnostics::noteLoadBlock(State *state, uint64_t bytes, bool rejected) {
+        if (!active || abortRequested) {
+            return;
+        }
