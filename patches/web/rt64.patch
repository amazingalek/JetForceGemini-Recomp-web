+        if (dmaDepth > DKRMaxDMADepth) {
+            dmaFaultAddress = address;
+            dmaDepth--;
+            requestAbort(state, AbortReason::DMADepth);
+            return false;
+        }
+
+        if (dmaDepth == DKRWarningDMADepth) {
+            report(state, "dma-depth-warning");
+        }
+
+        return true;
+    }
+
+    void DKRDisplayListDiagnostics::leaveDMA() {
